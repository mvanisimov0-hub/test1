{
  "name": "sdv-calc",
  "private": true,
  "version": "0.1.0",
  "description": "Проектно-расчётный модуль отдела продаж «Строим для Вас»",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
